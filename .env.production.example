# ============================================================
# 生产环境 .env 模板（部署上线前复制为 .env 并填入真实值）
# 本地开发请继续使用 .env（APP_DEBUG=true），不要覆盖它。
# 部署 checklist：
#   1. cp .env.production.example .env
#   2. 填入真实 APP_KEY（php artisan key:generate）、DB、邮件、队列、缓存
#   3. php artisan config:cache && php artisan route:cache && php artisan view:cache
#   4. php artisan migrate --force
#   5. 确认 APP_DEBUG=false（泄露堆栈信息是重大安全隐患）
# ============================================================

APP_NAME=MyBlog
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ---------- 数据库（生产建议 MySQL / PostgreSQL）----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=forge
DB_PASSWORD=

# ---------- 会话 / 缓存 / 队列（生产建议 redis）----------
SESSION_DRIVER=redis
SESSION_LIFETIME=120

CACHE_STORE=redis

QUEUE_CONNECTION=redis
# 生产需常驻 worker：php artisan queue:work --daemon

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------- 文件存储 ----------
FILESYSTEM_DISK=public
# 如使用对象存储（S3 / OSS / COS），填好下方并设 FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-east-1
# AWS_BUCKET=

# ---------- 邮件（生产必须用真实 SMTP，禁止 log）----------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# ---------- 安全响应头（建议在反向代理 / 中间件统一加）----------
# HSTS / CSP / X-Frame-Options 等由 Web 服务器或中间件处理

VITE_APP_NAME="${APP_NAME}"
