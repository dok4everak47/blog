APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# 公开注册开关（默认关闭，博客通常不需要）
# ALLOW_REGISTRATION=true

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# 数据库配置
# ---------------------------------------------------------------------------
# 开发环境用 SQLite（零配置），生产环境推荐 PostgreSQL / MySQL
#
# PostgreSQL（推荐）：
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=blog
DB_USERNAME=postgres
DB_PASSWORD=
#
# SQLite（快速原型）：
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite
#
# MySQL / MariaDB：
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=blog
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# ---------------------------------------------------------------------------
# 文件存储配置
# ---------------------------------------------------------------------------
# 生产环境建议切换到 S3 / 阿里云 OSS / 腾讯云 COS（多机器部署必须）
# 本地磁盘：FILESYSTEM_DISK=public
# AWS S3：FILESYSTEM_DISK=s3 + 下方 AWS_* 配置
FILESYSTEM_DISK=public

QUEUE_CONNECTION=database

# ---------------------------------------------------------------------------
# 缓存配置
# ---------------------------------------------------------------------------
# 单机部署：CACHE_STORE=database（当前）
# 生产环境推荐：CACHE_STORE=redis（需安装 Redis）
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# 邮件配置
# ---------------------------------------------------------------------------
# 生产环境必须配置真实的 SMTP，否则注册/找回密码邮件不会发出
# 开发环境用 log（邮件写入 storage/logs/laravel.log）
#
# 常见 SMTP 供应商：
#   QQ 邮箱：smtp.qq.com:465（SSL），开启 SMTP 后用授权码作密码
#   163 邮箱：smtp.163.com:465（SSL）
#   Gmail：smtp.gmail.com:587（TLS）
#   Resend / SendGrid / Mailgun：使用各自的 API 配置
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# AWS S3 配置（可选，用于文件存储迁移到云端）
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Vite 前端构建变量
# ---------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
